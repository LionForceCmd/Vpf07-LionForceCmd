# Ключ OpenAI (https://platform.openai.com/api-keys).
# Без него агент запускается в offline-режиме: инструменты работают,
# но вместо модели инструмент выбирает локальный планировщик по ключевым словам.
OPENAI_API_KEY=sk-...

# Модель чата (по умолчанию gpt-4o-mini)
MODEL=gpt-4o-mini

# Параметры генерации (необязательно)
TEMPERATURE=0.3
MAX_TOKENS=1000

# Файл долговременной памяти (по умолчанию memory.json рядом с агентом)
# MEMORY_FILE=memory.json